<?xml version="1.0" encoding="UTF-8"?>
<T3DataStructure>
    <sheets>
        <sDEF>
            <ROOT>
                <TCEforms>
                    <sheetTitle>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.sheet_general</sheetTitle>
                </TCEforms>
                <type>array</type>
                <el>
                    <settings.list>
                        <TCEforms>
                            <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.list</label>
                            <config>
                                <type>input</type>
                                <size>50</size>
                                <eval>trim,required</eval>
                                <placeholder>newsman@example.com</placeholder>
                            </config>
                        </TCEforms>
                    </settings.list>
                    <settings.successMessage>
                        <TCEforms>
                            <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.successMessage</label>
                            <config>
                                <type>text</type>
                                <cols>40</cols>
                                <rows>3</rows>
                            </config>
                        </TCEforms>
                    </settings.successMessage>
                    <!-- Overrides of the extension settings, for the email mode
                         only. The first option of the select is the global value,
                         which is why it carries no value of its own. -->
                    <settings.emailCommand>
                        <TCEforms>
                            <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.emailCommand</label>
                            <config>
                                <type>select</type>
                                <items>
                                    <item>
                                        <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.emailCommand.inherit</label>
                                        <!-- An explicit empty value, so the field
                                             saves as '' instead of the index 0,
                                             which the controller reads as
                                             "inherit" as well but by accident. -->
                                        <value></value>
                                    </item>
                                    <item>
                                        <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.emailCommand.subscribe</label>
                                        <value>subscribe</value>
                                    </item>
                                    <item>
                                        <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.emailCommand.request</label>
                                        <value>request</value>
                                    </item>
                                </items>
                            </config>
                        </TCEforms>
                    </settings.emailCommand>
                    <settings.emailSender>
                        <TCEforms>
                            <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.emailSender</label>
                            <config>
                                <type>input</type>
                                <size>40</size>
                                <placeholder>newsman@example.com</placeholder>
                            </config>
                        </TCEforms>
                    </settings.emailSender>
                    <!-- The texts of the form. A site shows the block of its
                         own mail service, whose texts are not part of the public
                         API, so they are settings of the element. -->
                    <settings.emailLabel>
                        <TCEforms>
                            <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.emailLabel</label>
                            <config>
                                <type>input</type>
                                <size>40</size>
                                <default>E-Mail-Adresse *</default>
                            </config>
                        </TCEforms>
                    </settings.emailLabel>
                    <settings.emailPlaceholder>
                        <TCEforms>
                            <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.emailPlaceholder</label>
                            <config>
                                <type>input</type>
                                <size>40</size>
                                <default>E-Mail-Adresse *</default>
                            </config>
                        </TCEforms>
                    </settings.emailPlaceholder>
                    <settings.buttonLabel>
                        <TCEforms>
                            <label>LLL:EXT:newsman/Resources/Private/Language/locallang.xlf:flexform.buttonLabel</label>
                            <config>
                                <type>input</type>
                                <size>40</size>
                                <default>Newsletter abonnieren</default>
                            </config>
                        </TCEforms>
                    </settings.buttonLabel>
                </el>
            </ROOT>
        </sDEF>
    </sheets>
</T3DataStructure>
