{
    "name": "ipf/newsman",
    "description": "Newsman subscription extension with Mailman integration",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "require": {
        "php": ">=8.1",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-extbase": "^13.4 || ^14.3",
        "typo3/cms-fluid": "^13.4 || ^14.3"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.0 || ^9.0"
    },
    "suggest": {
        "subugoe/typo3-cap": "Protects the signup form against bots with a proof-of-work challenge (TYPO3 12.4/13.4, path based), see Documentation/Usage.rst"
    },
    "autoload": {
        "psr-4": {
            "Ipf\\NewsMan\\": "Classes/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true,
            "typo3/cms-core": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "newsman",
            "version": "1.0.0",
            "providesPackages": {
                "ipf/newsman": "1.0.0"
            }
        }
    }
}
